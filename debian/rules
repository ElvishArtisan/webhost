#!/usr/bin/make -f

build:	
	dh_update_autotools_config
	dh_autoreconf
	 ./configure --prefix=/usr --libdir=/usr/lib
	make $(DEBUILD_MAKE_ARGS)

binary:	
	dh_testroot
	dh_prep
	dh_auto_install
	dh_installchangelogs ChangeLog

#
# webhost5
#
	mkdir -p debian/webhost5/usr/lib
	mv debian/tmp/usr/lib/libwebhost5.so.* debian/webhost5/usr/lib/
	mkdir -p debian/webhost5/usr/share/doc/webhost5
	cp AUTHORS debian/webhost5/usr/share/doc/webhost5/
	cp ChangeLog debian/webhost5/usr/share/doc/webhost5/
	cp NEWS debian/webhost5/usr/share/doc/webhost5/
	cp README debian/webhost5/usr/share/doc/webhost5/
	cp conf/webhost-sample.conf debian/webhost5/usr/share/doc/webhost5/
#
# webhost5-dev
#
	mkdir -p debian/webhost5-dev/usr/include
	mv debian/tmp/usr/include/wh5 debian/webhost5-dev/usr/include/
	mkdir -p debian/webhost5-dev/usr/lib
	mv debian/tmp/usr/lib/*.a debian/webhost5-dev/usr/lib/
	mkdir -p debian/webhost5-dev/usr/share
	mv debian/tmp/usr/lib/pkgconfig debian/webhost5-dev/usr/share/

	dh_strip_nondeterminism
	dh_compress
	dh_fixperms
	dh_missing
	dh_dwz
	dh_strip
	dh_makeshlibs
	dh_shlibdeps
	dh_installdeb
	dh_gencontrol
	dh_md5sums
	dh_builddeb

%:	
	dh $@
