#!/usr/bin/make -f

build:	
	dh_update_autotools_config
	dh_autoreconf
	 ./configure --prefix=/usr --libdir=/usr/lib
	make $(DEBUILD_MAKE_ARGS)

binary:	
	dh_testroot
	dh_prep
	dh_auto_install
	dh_installchangelogs ChangeLog

#
# webhost6
#
	mkdir -p debian/webhost6/usr/lib
	mv debian/tmp/usr/lib/libwebhost6.so.* debian/webhost6/usr/lib/
	mkdir -p debian/webhost6/usr/lib/systemd/system/
	mv debian/tmp/usr/lib/systemd/system/webhost.service debian/webhost6/usr/lib/systemd/system/
	mkdir -p debian/webhost6/usr/sbin
	mv debian/tmp/usr/sbin/webhostd debian/webhost6/usr/sbin/
	mkdir -p debian/webhost6/usr/share/doc/webhost6
	cp AUTHORS debian/webhost6/usr/share/doc/webhost6/
	cp ChangeLog debian/webhost6/usr/share/doc/webhost6/
	cp NEWS debian/webhost6/usr/share/doc/webhost6/
	cp README debian/webhost6/usr/share/doc/webhost6/
	cp conf/webhost-sample.conf debian/webhost6/usr/share/doc/webhost6/
#
# webhost6-dev
#
	mkdir -p debian/webhost6-dev/usr/include
	mv debian/tmp/usr/include/wh6 debian/webhost6-dev/usr/include/
	mkdir -p debian/webhost6-dev/usr/lib
	mv debian/tmp/usr/lib/*.a debian/webhost6-dev/usr/lib/
	mv debian/tmp/usr/lib/*.la debian/webhost6-dev/usr/lib/
	mv debian/tmp/usr/lib/libwebhost6.so debian/webhost6-dev/usr/lib/
	mkdir -p debian/webhost6-dev/usr/share
	mv debian/tmp/usr/lib/pkgconfig debian/webhost6-dev/usr/share/

	dh_strip_nondeterminism
	dh_compress
	dh_fixperms
	dh_missing
	dh_dwz
	dh_strip
	dh_makeshlibs
	dh_shlibdeps
	dh_installdeb
	dh_gencontrol
	dh_md5sums
	dh_builddeb

%:	
	dh $@
